# TWS_PORT=7497
# TWS_CLIENT_ID=17
# RTH_TIMEZONE=America/New_York
# RTH_OPEN_HOUR=9
# RTH_OPEN_MINUTE=30
# RTH_QUOTE_TIMEOUT_SECONDS=900
# RTH_MOC_HOUR=15
# RTH_MOC_MINUTE=45
# RTH_MOC_CUTOFF_HOUR=15
# RTH_MOC_CUTOFF_MINUTE=50
# BP_RESERVE_PCT=0.05
# LONG_MARGIN_PCT=1.0
# SHORT_MARGIN_PCT=1.0
